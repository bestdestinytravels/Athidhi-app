# Postgres connection strings from Neon (neon.tech):
# - DATABASE_URL: the POOLED connection string (has "-pooler" in the hostname).
#   Used by the running app - required because Vercel runs this as serverless
#   functions, which open many short-lived connections.
# - DIRECT_URL: the DIRECT (non-pooled) connection string.
#   Used only when running `npx prisma db push` / migrations.
# Neon's dashboard shows both - copy each one into the matching variable below.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/athidhi?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/athidhi?sslmode=require"

# Secret used to sign login session cookies - generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-string"

# Shared login password for staff (Ashwin / Shiva)
APP_PASSWORD="Athidhi6"

# --- Google Sheets sync (optional - leave blank to disable) ---
# The service account's client email, e.g. athidhi-sync@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The service account's private key. Keep the \n characters literal (paste exactly as given in the JSON key file).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# The ID of the Google Sheet (the long string in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=""
